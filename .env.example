# SkillSetu Environment Configuration Template
# Copy this file to .env or .env.local and fill in your Gemini API key.

# Google Gemini API Key (obtained from https://aistudio.google.com/)
VITE_GEMINI_API_KEY=your_actual_gemini_api_key_here

# Optional Backend API Base URL (defaults to http://localhost:8000 when empty)
VITE_API_BASE_URL=http://localhost:8000

